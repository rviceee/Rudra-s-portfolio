 const st=now=>{const t=Math.min(1,(now-t0)/dur);scrollTo({top:y0+d*(1-Math.pow(1-t,4)),left:0,behavior:'instant'});if(t<1)sa=requestAnimationFrame(st)};sa=requestAnimationFrame(st)};
['touchstart','wheel'].forEach(ev=>addEventListener(ev,()=>cancelAnimationFrame(sa),{passive:true}));
$$('#dock a[data-s]').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();const t=$(a.getAttribute('href')),pt=parseFloat(getComputedStyle(t).paddingTop)||0;goTo(t.getBoundingClientRect().top+scrollY+pt-70)}));
['long','short','about'].forEach(id=>new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)$$('#dock a[data-s]').forEach(a=>a.classList.toggle('on',a.dataset.s===id))}),{rootMargin:'-45% 0px -50% 0px'}).observe($('#'+id)));
const gsEl=$('#gs'),shc=$$('#gs .card'),dots=$('#dots');shc.forEach(()=>dots.insertAdjacentHTML('beforeend','<i></i>'));const dd=$$('#dots i');let ft=0;
const upd=()=>{ft=0;if(!matchMedia('(max-width:860px)').matches)return;const c=gsEl.getBoundingClientRect(),mid=c.left+c.width/2;let best=0,bd=1e9;
 shc.forEach((cd,i)=>{const r=cd.getBoundingClientRect(),d=Math.abs(r.left+r.width/2-mid),k=Math.max(0,1-d/(c.width*.75));cd.querySelector('.th').style.setProperty('--sc',(.86+.14*k).toFixed(3));if(d<bd){bd=d;best=i}});dd.forEach((x,i)=>x.classList.toggle('on',i===best))};
gsEl.addEventListener('scroll',()=>{if(!ft)ft=requestAnimationFrame(upd)},{passive:true});addEventListener('resize',upd);upd();
document.addEventListener('click',e=>{if(e.target.closest('.card,#dock a,.btn'))vib(8)});
if(matchMedia('(hover:none)').matches){
 const on=()=>addEventListener('deviceorientation',e=>{if(e.gamma==null)return;mx=innerWidth*(.5+Math.max(-1,Math.min(1,e.gamma/30))*.5);my=innerHeight*(.5+Math.max(-1,Math.min(1,(e.beta-55)/30))*.5)},{passive:true});
 if(typeof DeviceOrientationEvent!=='undefined'&&DeviceOrientationEvent.requestPermission){const tl=$('.tilt');tl.textContent='Tap to enable tilt';tl.style.cursor='pointer';tl.onclick=()=>DeviceOrientationEvent.requestPermission().then(r=>{if(r==='granted'){on();tl.textContent='Tilt your phone'}}).catch(()=>{})}else on()}
// lightbox
const lb=$('#lb'),fr=lb.querySelector('.fr'),ext=lb.querySelector('.ext');
const closeLB=()=>{lb.classList.remove('on');setTimeout(()=>{if(!lb.classList.contains('on'))fr.innerHTML=''},500)};
document.addEventListener('click',e=>{
 const a=e.target.closest('[data-yt],[data-ig]');
 if(a&&!e.metaKey&&!e.ctrlKey){e.preventDefault();const u=a.href||a.dataset.u,ig=a.dataset.ig;fr.className='fr'+(/shorts/.test(u)||ig?' v':'');
  fr.innerHTML=`<iframe src="${ig?'https://www.instagram.com/reel/'+ig+'/embed':'https://www.youtube-nocookie.com/embed/'+a.dataset.yt+'?autoplay=1&rel=0'}" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>`;
  ext.href=u;ext.textContent=ig?'Open on Instagram ↗':'Open on YouTube ↗';lb.classList.add('on')}
 if(e.target===lb||e.target.closest('.x'))closeLB()});
addEventListener('keydown',e=>{if(e.key==='Escape')closeLB()});
</script>
